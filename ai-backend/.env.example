# ==============================================================================
# 🧠 TALEEMONE AI COGNITIVE BACKEND — 4-TIER AUTO-FALLBACK CONFIGURATION TEMPLATE
# Powered by Barkat Tech
# ==============================================================================

# Server Network & Runtime
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 🛡️ 4-Layer Handshake Security Armor
# ------------------------------------------------------------------------------
AI_SERVICE_SECRET_KEY=TaleemOne_AI_Secure_Handshake_2026_@BarkatTech
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 🔄 4-Tier Multi-Model Automatic Failover Chain
# Flow: Tier 1 (Groq) ➔ Tier 2 (OpenRouter) ➔ Tier 3 (Gemini) ➔ Tier 4 (OpenAI)
# Zero code change: Provider order & models are 100% dynamic from this file!
# ------------------------------------------------------------------------------
AI_FALLBACK_CHAIN=groq,openrouter,gemini,openai

# ── Tier 1: Groq Cloud (Ultra Fast 0.4s Response) ────────────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Tier 2: OpenRouter (Universal AI Gateway - Free & Paid Models) ───────────
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Tier 3: Google Gemini (High Accuracy 2.0 Brain) ─────────────────────────
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Tier 4: OpenAI (Enterprise Backup - GPT-4o-mini) ─────────────────────────
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
